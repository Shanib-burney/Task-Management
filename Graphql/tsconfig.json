{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@prisma-client": [
        "src/generated/prisma/client"
      ],
      "@prisma-client/models": [
        "src/generated/prisma/models"
      ]
    }
  }
}